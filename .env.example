# Copy to .env — never commit real secrets. Use Key Vault / managed identity in Azure.
DATABASE_URL=postgresql+psycopg2://datapilot:datapilot@postgres:5432/datapilot
JWT_SECRET=generate-a-long-random-value-at-least-32-bytes
STORAGE_BACKEND=local            # local | adls
LOCAL_STORAGE_PATH=/data/raw
ADLS_ACCOUNT_URL=
ADLS_FILESYSTEM=raw
ANALYTICS_PATH=/data/analytics
# Optional: enables the Azure OpenAI planner (otherwise a deterministic rule-based planner is used)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=            # chat model deployment name
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=  # embeddings deployment name (for RAG)
AZURE_OPENAI_API_VERSION=2024-10-21

# Databricks (optional; ANALYTICS_BACKEND=duckdb is the default)
ANALYTICS_BACKEND=duckdb
DATABRICKS_SERVER_HOSTNAME=         # host only, e.g. adb-123456.7.azuredatabricks.net (no https://)
DATABRICKS_HTTP_PATH=               # /sql/1.0/warehouses/<id>
DATABRICKS_CATALOG=
DATABRICKS_TOKEN=                   # keep ONLY in your private .env
DATABRICKS_READONLY_TOKEN=
