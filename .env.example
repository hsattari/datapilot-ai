# Copy to .env — never commit real secrets. Use Key Vault / managed identity in Azure.
DATABASE_URL=postgresql+psycopg2://datapilot:datapilot@postgres:5432/datapilot
JWT_SECRET=generate-a-long-random-value-at-least-32-bytes
STORAGE_BACKEND=local            # local | adls
LOCAL_STORAGE_PATH=/data/raw
ADLS_ACCOUNT_URL=
ADLS_FILESYSTEM=raw
ANALYTICS_PATH=/data/analytics
# Optional: enables the Azure OpenAI planner (otherwise a deterministic rule-based planner is used)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
